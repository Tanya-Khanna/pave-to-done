{
  "name": "pave-to-done",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "types:worker": "wrangler types worker-configuration.d.ts --include-runtime false",
    "types:worker:check": "wrangler types worker-configuration.d.ts --include-runtime false --check",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "capture:demo": "node scripts/capture-demo.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "lint": "eslint .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.54.2",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260901.1",
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^6.0.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fast-check": "^4.9.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.128.0"
  }
}
